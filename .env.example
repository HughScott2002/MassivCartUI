# ── Supabase (safe to expose — anon key only) ─────────────────────────────────
# Defaults target the LOCAL stack started by `make up` / `make db` in
# MassivCartAPI. The local development key is deterministic on every machine —
# safe to commit. For cloud, swap both values for your project's.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ── Mapbox ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.<mapbox-public-token>

# ── Backend ───────────────────────────────────────────────────────────────────
# Server-side only — Next.js → Express. Never exposed to the browser.
# MassivCartAPI via `make up` or `make dev` listens here.
BACKEND_URL=http://localhost:8000

# ── Admin routes ──────────────────────────────────────────────────────────────
# Same value as PLACES_SYNC_SECRET in the backend .env.
# Used server-side only by /api/admin/* Next.js routes.
PLACES_SYNC_SECRET=<random-hex>

# Server-side only — /api/stores/submit uses this to bypass RLS.
# Default is the local stack's development key. Falls back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
